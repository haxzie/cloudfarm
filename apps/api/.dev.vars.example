# Copy to .dev.vars for local `wrangler dev`.

# Generate a value with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# GitHub OAuth app (https://github.com/settings/developers).
# Authorization callback URL: http://localhost:8797/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Anthropic API key used by the bot agents.
ANTHROPIC_API_KEY=

# R2 API token (Object Read & Write) so each bot's folder can be mounted in its
# sandbox. The sandbox never sees these — the Worker signs every request.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# The deployed origins live in cloudflare.config.ts; these override them so
# local dev talks to the dev servers instead of production.
WEB_URL=http://localhost:3101
BETTER_AUTH_URL=http://localhost:8797
